# ─────────────────────────────────────────────────────────────────
# Copie este arquivo para .env (e configure no painel do Vercel).
# ─────────────────────────────────────────────────────────────────

# URL base da Open Library API (não precisa alterar)
VITE_API_BASE=https://openlibrary.org

# E-mail que vira admin automaticamente (exposto no client — apenas define papel)
VITE_ADMIN_EMAIL=adeildo.manoel.aguiar@gmail.com

# ── Backend / envio real de e-mail (variáveis de SERVIDOR — sem VITE_) ──
# Sem estas variáveis o app funciona em "modo demonstração": o código
# aparece na tela em vez de ser enviado por e-mail.

# Segredo usado para assinar os tokens de código OTP. Gere um valor longo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# O provedor de envio é escolhido pela chave presente (nesta ordem):
#   1) BREVO_API_KEY  -> Brevo. NÃO precisa de domínio: basta verificar 1
#      e-mail remetente (https://app.brevo.com -> Senders). Entrega p/ qualquer um.
#   2) RESEND_API_KEY -> Resend. Precisa de domínio verificado p/ enviar a terceiros.
#   3) nenhuma        -> modo demonstração (código aparece na tela).
BREVO_API_KEY=
RESEND_API_KEY=

# Remetente dos e-mails no formato "Nome <email>".
# Brevo: use um remetente VERIFICADO na sua conta Brevo (ex.: seu Gmail).
# Resend: use onboarding@resend.dev (só p/ você) ou um e-mail do domínio verificado.
EMAIL_FROM=BiblioJala <onboarding@resend.dev>
